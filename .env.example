# Copy this file to `.env` and fill in real values. Never commit `.env`.

DB_NAME=boss
DB_USERNAME=boss
DB_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=boss-platform

CORS_ALLOWED_ORIGINS=http://localhost:4200

# AI_PROVIDER=mock uses MockAiClient (no external calls, no key required).
# Switch to a real provider once the `ai` module is implemented (phase 5).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
